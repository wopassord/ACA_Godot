# Normalize EOL for all files that Git considers text files.
*.cs text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.project text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.gltf text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf


# We maintain the crlf for visual studio / C# files
*.sln text eol=crlf
*.csproj text eol=crlf